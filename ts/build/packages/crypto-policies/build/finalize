#crypto-policies 80

if [ -e /FIPS ]; then
        cp -a /etc/crypto-policies/FIPS/* /etc/crypto-policies/.
	mkdir -p /etc/gcrypt
	touch /etc/gcrypt/fips_enabled
        rm -rf /FIPS
	systemctl enable fips-crypto-policy-overlay
elif [ -e /LEGACY ]; then
	rm -rf /LEGACY
	cp -a /etc/crypto-policies/LEGACY/* /etc/crypto-policies/.
else
        cp -a /etc/crypto-policies/DEFAULT/* /etc/crypto-policies/.
fi
rm -rf /etc/crypto-policies/FIPS /etc/crypto-policies/DEFAULT /etc/crypto-policies/LEGACY

