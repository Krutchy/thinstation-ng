#udsclient 60
mimelist=/etc/xdg/mimeapps.list

mkdir -p `dirname $mimelist`
if [ -e $mimelist ] && ! grep -e "Default Applications" $mimelist -q || ! [ -e $mimelist ]; then
	echo '[Default Applications]' >> $mimelist
fi
echo 'x-scheme-handler/udss=UDSClient.desktop' >> $mimelist

if [ -n "$UDS_BROKER_DNS_NAME" ]; then
    mkdir -p /etc/opt/chrome/policies/managed
    cat <<EOF > /etc/opt/chrome/policies/managed/auto_open_policy.json
{
    "AutoLaunchProtocolsFromOrigins": [
        {
            "allowed_origins": ["https://$UDS_BROKER_DNS_NAME"],
            "protocol": "udss"
        }
    ]
}
EOF

    mkdir -p /etc/skel/.config/Virtual\ Cable\ S.L.U.
    cat <<EOF> /etc/skel/.config/Virtual\ Cable\ S.L.U./UDS\ Connector.conf
[endpoints]
$UDS_BROKER_DNS_NAME=true"
EOF

fi
