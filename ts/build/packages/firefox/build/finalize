#firefox 60
systemctl enable firefox-init

sqlite3 /etc/TS.default/permissions.sqlite <<EOF
PRAGMA foreign_keys=OFF;
BEGIN TRANSACTION;
CREATE TABLE moz_perms (
    id INTEGER PRIMARY KEY,
    origin TEXT,
    type TEXT,
    permission INTEGER,
    expireType INTEGER,
    expireTime INTEGER,
    modificationTime INTEGER
);
CREATE TABLE moz_hosts (
    id INTEGER PRIMARY KEY,
    host TEXT,
    type TEXT,
    permission INTEGER,
    expireType INTEGER,
    expireTime INTEGER,
    modificationTime INTEGER,
    isInBrowserElement INTEGER
);
COMMIT;
EOF

